{# 1. Import các nguyên tử để đảm bảo tính đồng bộ #}
{% from "lib/atoms.njk" import renderHeading, renderRichText %}
  {% from "components/canhoCard.njk" import bancanho %}
{# 
  Macro renderDataSection
  Tham số:
  - jsonPath: Đường dẫn tới file .json (sử dụng readJson)
  - title: Tiêu đề section (hỗ trợ parseAttr)
  - description: Mô tả ngắn (hỗ trợ markdown & parseAttr)
  - moreLink: Đường dẫn trang "Xem thêm"
  - class: Các class CSS bổ sung cho thẻ section
  - id: ID định danh cho section
  - cardMacro: Macro dùng để render từng item trong danh sách
#}
{% macro renderDataSection(
  jsonPath = "",
  title = "Tiêu đề section",
  description = "",
  moreLink = "",
  class = "",
  id = "",
  cardMacro = none
) %}

  {# Sử dụng global function readJson được đăng ký trong tools.js [1, 2] #}
  {% set listings = readJson(jsonPath) %}

  {% if listings %}


    <section {% if id %}id="{{ id }}"{% endif %} class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 {{ class }}">
      {# Khối Header của Section #}
      
        <div class=" flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
            <div class="flex items-center gap-2">
                {# Vạch màu đặc trưng của brand #}
                <span class="w-2.5 h-6 bg-emerald-600 rounded-full inline-block"></span>
                
                {# Sử dụng renderHeading để hỗ trợ cú pháp { .class #id } [3] #}
                {{ renderHeading(content=title, level=2, baseClass="text-2xl font-bold text-gray-900") }}
            </div>
            
            {# Sử dụng renderRichText để xử lý Markdown và thuộc tính tùy biến [4] #}
            {% if description %}
                {{ renderRichText(content=description, baseClass="text-sm text-gray-500 mt-1") }}
            {% endif %}
            </div>

        {# Nút Xem thêm #}
            {% if moreLink %}
            <div class="flex flex-wrap gap-2 text-xs font-semibold">
                <a href="{{ moreLink }}">
                <span class="bg-emerald-50 text-emerald-700 px-3 py-1.5 rounded-lg cursor-pointer hover:bg-emerald-100 transition">
                    Xem thêm
                </span>
                </a>
            </div>
            {% endif %}
      </div>

      {# Khối Grid hiển thị nội dung #}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for item in listings %}
            {% if cardMacro %}
                {# Gọi macro được truyền vào để render item [5, 6] #}
                {{ cardMacro(item) }}
            {% else %}
                {# Hiển thị mặc định nếu không có cardMacro #}
                <div class="p-4 border rounded">
                <p class="font-bold">{{ item.title }}</p>
                </div>
            {% endif %}
            {% endfor %}
        </div>
    
    </section>
  {% endif %}
{% endmacro %}
