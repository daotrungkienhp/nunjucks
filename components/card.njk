{% macro homeCard(item) %}
{% set badgeColor = "bg-red-500" if item.sale else "bg-emerald-600" %}
{% set badgeLabel = "Cần Bán" if item.sale else "Cho Thuê" %}
{% set priceColor = "text-red-600" if item.sale else "text-emerald-600" %}
{% set priceUnit = " Tỷ" if item.sale else " Triệu/tháng" %}
{% set featureImageUrl = (item.permalink ~ "feature-image.webp") if item.featureImage else "https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?auto=format&fit=crop&w=500&q=80" %}
{% set imageCount = item.images | length if item.images else 0 %}

<a href="{{ item.permalink }}" class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md border border-gray-100 transition flex flex-col justify-between group">
    <div class="relative aspect-[4/3] bg-gray-200">
        <div class="w-full h-full bg-cover bg-center group-hover:scale-105 transition duration-300" style="background-image: url('{{ featureImageUrl }}');"></div>
        {# <span class="{{ badgeColor }} absolute top-3 left-3 text-white text-xs font-bold uppercase px-2.5 py-1 rounded-md shadow-sm">{{ badgeLabel }}</span>
        {% if imageCount > 0 %}
        <span class="absolute bottom-3 right-3 bg-black/60 text-white text-xs font-medium px-2 py-1 rounded-md backdrop-blur-sm"><i class="fa-regular fa-image mr-1"></i> {{ imageCount }} Ảnh</span>
        {% endif %} #}
    </div>

    <div class="p-5 flex-1 flex flex-col justify-between">
        <div>
            <div class="flex items-center gap-2 mb-2 text-xs font-semibold text-emerald-600">
                {% if item.subSection %}<span class="bg-emerald-50 px-2 py-0.5 rounded">{{ item.subSection }}</span>{% endif %}
                {% if item.direction %}<span>Hướng {{ item.direction }}</span>{% endif %}
            </div>
            <h3 class="font-bold text-gray-900 text-base line-clamp-2 group-hover:text-emerald-600 transition mb-2">
                {{ item.title }}
            </h3>
            {% if item.excerpt %}
            <p class="text-sm text-gray-500 line-clamp-2 mb-4">{{ item.excerpt }}</p>
            {% endif %}
        </div>

        <div>
            <div class="grid grid-cols-3 border-t border-b border-gray-100 py-2.5 mb-4 text-xs font-medium text-gray-500 text-center">
                {% if item.area %}<div><i class="fa-solid fa-ruler-combined text-emerald-600 mr-1"></i> {{ item.area }} m²</div>{% endif %}
                {% if item.bedrooms %}<div><i class="fa-solid fa-bed text-emerald-600 mr-1"></i> {{ item.bedrooms }} PN</div>{% endif %}
                {% if item.bathrooms %}<div><i class="fa-solid fa-bath text-emerald-600 mr-1"></i> {{ item.bathrooms }} WC</div>{% endif %}
            </div>

            <div class="flex justify-between items-center">
                <div class="text-lg font-bold {{ priceColor }}">
                    {% if item.price %}{{ item.price }}{{ priceUnit }}{% else %}Thỏa thuận{% endif %}
                </div>
                {% if item.legalStatus %}
                <div class="flex items-center gap-1.5 text-xs text-amber-600 font-semibold bg-amber-50 px-2 py-1 rounded">
                    <i class="fa-solid fa-shield-check"></i> {{ item.legalStatus }}
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</a>
{% endmacro %}
