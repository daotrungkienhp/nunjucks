<!DOCTYPE html>
<html lang="{{ language or 'vi' }}" x-data="{ darkMode: false }" :class="{ 'dark': darkMode }" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <title>{{ title or siteName }} | {{ brand }}</title>
  <meta name="description" content="{{ description or footerText }}">
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://{{ domain }}{{ permalink or '/' }}">
  <meta property="og:title" content="{{ title or siteName }}">
  <meta property="og:description" content="{{ description or footerText }}">
  {% if featureImage %}
    <meta property="og:image" content="{{ featureImage }}">
  {% endif %}

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&family=Be+Vietnam+Pro:ital,wght@0,100;0,300;0,400;0,500;0,700;1,300&family=Inter:wght@300;400;500;600;700&family=Lexend:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- AlpineJS, UnoCSS & Lucide Icons -->
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/lucide@latest/dist/umd/lucide.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      if (typeof lucide !== 'undefined') lucide.createIcons();
    });
  </script>
  <link rel="stylesheet" href="/assets/css/style.css">
  <link rel="stylesheet" href="/assets/css/toc.css">

  <!-- Schema.org JSON-LD -->
  {% if _schema %}
    <script type="application/ld+json">
      {{ _schema | dump | safe }}
    </script>
  {% endif %}
</head>
<body class="min-h-screen bg-background text-foreground transition-colors duration-300 antialiased selection:bg-secondary/30 selection:text-primary">

  <!-- Assembled Header Partial -->
  {% block header %}
    {% include "partials/header.njk" %}
  {% endblock %}

  {% if subnav %}
    {% include "components/tabMenu.njk" %}
  {% endif %}

  <!-- Main Content Container -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 warm-overlay">
    <div class="{% if not fullWidth %}prose dark:prose-invert max-w-4xl mx-auto{% endif %}">
      {% block content %}
        {{ content | safe }}
      {% endblock %}
    </div>
  </main>

  <!-- MTT Footer -->
  {% include "partials/footer.njk" %}
  <script src="/assets/js/toc.js" defer></script>

</body>
</html>
