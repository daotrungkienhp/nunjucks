{#
  ##############################################################################
  Shared Atoms — dùng chung cho tất cả bricks
  ##############################################################################

  renderImage()
  ------------
  Render một thẻ <img> chuẩn với đầy đủ thuộc tính accessibility + performance.
  
  Cách dùng:
    {% from "bricks/shared/atoms.njk" import renderImage %}

    {{ renderImage(
      src=item.image,
      alt=item.title,
      title=item.title,
      class="bem-card__image"
    ) }}

  Nếu item có trường imageAlt / imageTitle riêng:
    {{ renderImage(
      src=item.image,
      alt=item.imageAlt or item.title,
      title=item.imageTitle or item.title,
      class="bem-card__image"
    ) }}

  Đối với ảnh trang trí (decorative, icon):
    {{ renderImage(src=item.icon, alt="", class="bem-features__icon-img") }}

  Tất cả thuộc tính đều có giá trị mặc định hợp lý:
    - loading="lazy"  (trừ header logo dùng "eager")
    - decoding="async"
    - alt=""          (mặc định rỗng — không bao giờ thiếu thuộc tính alt)
    - title=""        (mặc định rỗng)
#}




{#
  renderAvatar()
  --------------
  Render ảnh đại diện (avatar) với class mặc định và aria-label.
#}

{% macro renderImage(src, alt="", title="", class="", loading="lazy", decoding="async", width="", height="") %}
  <img src="{{ src }}"
   {% if alt %}alt="{{ alt }}"{% endif %}
   {% if title %}title="{{ title }}"{% endif %}
   class="{{ class }}"
   loading="{{ loading }}"
   decoding="{{ decoding }}"
   {% if width %}width="{{ width }}"{% endif %}
   {% if height %}height="{{ height }}"{% endif %} />
{% endmacro %}

{% macro button(text="Click me", type="button", class="", variant="primary") %}
  <button type="{{ type }}" class="btn btn-{{ variant }} {{ class }}">
    {{ text }}
  </button>
{% endmacro %}

{% macro input(type="text", name="", placeholder="", value="", class="") %}
  <input 
    type="{{ type }}" 
    name="{{ name }}" 
    placeholder="{{ placeholder }}" 
    value="{{ value }}" 
    class="input-field {{ class }}"
  >
{% endmacro %}

{% macro label(text, for="") %}
  <label class="label" {% if for %}for="{{ for }}"{% endif %}>
    {{ text }}
  </label>
{% endmacro %}