{% from "bricks/blog/atoms.njk" import renderBlogCard %}

{% macro renderBlogPosts(options={}) %}
  {% set items = options.items or [] %}
  {% set cols = options.cols or 3 %}

  {% set colClass = {
    1: "grid-cols-1 max-w-lg mx-auto",
    2: "grid-cols-1 md:grid-cols-2",
    3: "grid-cols-1 md:grid-cols-2 lg:grid-cols-3",
    4: "grid-cols-1 md:grid-cols-2 lg:grid-cols-4"
  } %}

  <div class="bem-blog__grid {{ colClass[cols] or colClass[3] }}">
    {% for post in items %}
      {{ renderBlogCard(post) }}
    {% endfor %}
  </div>
{% endmacro %}
