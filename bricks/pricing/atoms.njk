{% macro renderPricingBadge(text) %}
  <span class="bem-pricing__badge">{{ text }}</span>
{% endmacro %}

{% macro renderPricingPrice(amount, currency="₫", period="") %}
  <div class="bem-pricing__price-wrap">
    <span class="bem-pricing__currency">{{ currency }}</span>
    <span class="bem-pricing__amount">{{ amount }}</span>
    {% if period %}
      <span class="bem-pricing__period">{{ period }}</span>
    {% endif %}
  </div>
{% endmacro %}

{% macro renderPricingFeature(text, included=true) %}
  <li class="bem-pricing__feature bem-pricing__feature--{{ 'included' if included else 'excluded' }}">
    <span class="bem-pricing__feature-icon">
      {% if included %}
        <svg viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
      {% else %}
        <svg viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
      {% endif %}
    </span>
    <span>{{ text }}</span>
  </li>
{% endmacro %}
