{% from "bricks/shared/atoms.njk" import renderImage %}

{% macro renderCardImage(image, alt="") %}
  <div class="bem-card__image-wrap">
    {{ renderImage(
      src=image,
      alt=alt,
      title=alt,
      class="bem-card__image",
      loading="lazy"
    ) }}
  </div>
{% endmacro %}

{% macro renderCardBadge(text) %}
  <span class="bem-card__badge">{{ text }}</span>
{% endmacro %}

{% macro renderCardMeta(items=[]) %}
  {% if items %}
    <div class="bem-card__meta">
      {% for item in items %}
        <span class="bem-card__meta-item">
          {% if item.icon %}<span class="bem-card__meta-icon">{{ item.icon | safe }}</span>{% endif %}
          {{ item.text }}
        </span>
      {% endfor %}
    </div>
  {% endif %}
{% endmacro %}
