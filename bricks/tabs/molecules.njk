{% from "bricks/tabs/atoms.njk" import renderTabLink %}

{% macro renderTabs(items=[]) %}
  {% set totalTabs = items | length %}
  {% if totalTabs > 0 %}
    <div class="bem-tabs" x-data="{ activeTab: 0 }">
      <!-- Tabs Navigation Header -->
      <div class="bem-tabs__header">
        <ul class="bem-tabs__list">
          {% for item in items %}
            <li class="bem-tabs__item">
              {{ renderTabLink(item, loop.index0) }}
            </li>
          {% endfor %}
        </ul>
      </div>

      <!-- Tabs Content Panels -->
      <div class="bem-tabs__content">
        {% for item in items %}
          {% if not item.disabled %}
            <div x-show="activeTab === {{ loop.index0 }}" 
                 class="bem-tabs__panel"
                 x-transition:enter="transition ease-out duration-300"
                 x-transition:enter-start="opacity-0 translate-y-2"
                 x-transition:enter-end="opacity-100 translate-y-0"
                 style="display: none;">
              {{ item.content | markdown | safe }}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}
{% endmacro %}
